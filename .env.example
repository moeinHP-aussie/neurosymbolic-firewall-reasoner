# Copy this file to `.env` (same folder as webapp.py) and fill in your
# real key. `.env` itself is git-ignored -- never commit it.
#
#   cp .env.example .env
#
# webapp.py loads this file automatically at startup via python-dotenv
# (see requirements.txt). If python-dotenv is not installed, or no .env
# file is present, you can instead export the variable directly in your
# shell before running the app, e.g.:
#   export GEMINI_API_KEY=your-key-here
# A value already exported in the shell always takes priority over .env.
#
# Required for the natural-language query page (/query) only -- the rest
# of the app (upload/analyze, incremental check) works without this.
#
# You can set ONE key:
GEMINI_API_KEY=your-gemini-api-key-here
#
# ...or SEVERAL, comma-separated, to fall back automatically if a key
# is invalid, revoked, or out of quota (the app tries them left to
# right and remembers whichever one last worked, so it doesn't keep
# retrying dead keys on every question):
# GEMINI_API_KEY=key-one,key-two,key-three

# Optional. Only needed if you want to override the default Gemini model
# used for translating questions (see nl_query/nl_translator.py for the
# current default).
# FIREWALLLOGIC_GEMINI_MODEL=gemini-3.5-flash-lite

# Optional login for the web UI itself (unrelated to Gemini). If unset,
# the app runs without a login prompt.
# FIREWALLLOGIC_USERNAME=admin
# FIREWALLLOGIC_PASSWORD=change-me
